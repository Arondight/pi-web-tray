# Normalize line endings in the repository. Windows source files stay CRLF so they
# open correctly in Visual Studio and cmd.exe; documentation and YAML use LF.
* text=auto

*.cs            text eol=crlf
*.csproj        text eol=crlf
*.props         text eol=crlf
*.targets       text eol=crlf
*.sln           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf
*.ini           text eol=crlf
*.manifest      text eol=crlf
*.config        text eol=crlf
*.resx          text eol=crlf
*.xml           text eol=crlf

*.md            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.editorconfig   text eol=lf
.prettierignore text eol=lf
LICENSE         text eol=lf

*.ico           binary
*.png           binary
*.jpg           binary
*.exe           binary
*.pdb           binary
*.zip           binary
